# Copy this file to .env and fill in real values for local development.
# Every variable has a safe default in settings.py, so the app runs without
# this file - but features like Stripe, Twilio, Google OAuth and email won't work.

SECRET_KEY=change-me-to-a-random-secret-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated list of frontend origins allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# Redis (matches the "redis" service name in docker-compose.yml)
REDIS_URL=redis://redis:6379/1

# Public URL of the blog/storefront frontend (used for Stripe checkout redirects)
FRONTEND_URL=http://localhost:3000

# Twilio (SMS verification)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE=

# Stripe (payments)
STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=
STRIPE_WEBHOOK_SECRET=

# Google OAuth (social login)
GOOGLE_OAUTH2_KEY=
GOOGLE_OAUTH2_SECRET=

# Google reCAPTCHA
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Email (defaults to a Mailtrap sandbox inbox for local testing)
EMAIL_HOST=sandbox.smtp.mailtrap.io
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_PORT=2525
EMAIL_USE_TLS=True
