# Copy to .env and adjust for your environment. CRA only exposes vars prefixed REACT_APP_.

# Backend API base URL
REACT_APP_API_BASE_URL=http://localhost:8000

# Backend WebSocket host (no protocol/scheme, just host:port)
REACT_APP_WS_BASE_URL=localhost:8000

# Google OAuth client ID (social login)
REACT_APP_GOOGLE_OAUTH_CLIENT_ID=

# Google Maps JavaScript API key (used by the store-locator map)
REACT_APP_GOOGLE_MAPS_API_KEY=

# Google reCAPTCHA v2 site key
REACT_APP_RECAPTCHA_SITE_KEY=
